# PostgreSQL connection string supplied by your hosting provider.
DATABASE_URL=postgresql://user:password@host:5432/sahaayak
# Use a long random value in production.
JWT_SECRET=replace-with-a-long-random-secret
PORT=3000
NODE_ENV=production
DATABASE_SSL=true

# OTP provider (keep this secret; do not put it in VITE_ variables).
OTP_API_URL=https://auth.freebuff.app/send_otp
OTP_API_KEY=replace-with-your-provider-key
APP_NAME=Sahaayak
